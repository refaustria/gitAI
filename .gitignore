# Data — never commit corpora or derived artefacts.
# Note the /* form: git cannot re-include a file underneath an *excluded
# directory*, so `data/raw/` + `!data/raw/MANIFEST.json` would silently drop the
# manifest. Excluding the directory's contents instead keeps the negation live.
data/raw/*
data/interim/*
data/processed/*
!data/raw/MANIFEST.json
!data/LICENSES.md

# Runs, checkpoints, artefacts
runs/
*.bin
*.safetensors
*.ckpt
*.pt
*.pth
wandb/
mlruns/
outputs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Environment & editors
.env
.env.local
.DS_Store
.idea/
.vscode/

# Operator halt signal — runtime state, outside every root the loop may write to
control/
!control/.gitkeep
